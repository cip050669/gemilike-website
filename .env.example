# Database
DATABASE_URL=postgresql://user:password@localhost:5432/gemilike?schema=public

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here-change-in-production

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin Credentials (für einfache Login-Seiten - NICHT für Produktion empfohlen!)
# WARNUNG: Diese sollten nur für Development/Testing verwendet werden
# In Produktion sollten Sie NextAuth mit Datenbank-Authentifizierung verwenden
NEXT_PUBLIC_ADMIN_EMAIL=admin@gemilike.com
NEXT_PUBLIC_ADMIN_PASSWORD=change-me-in-production

# Google Analytics (optional)
NEXT_PUBLIC_GA_ID=

# Google Tag Manager (optional)
NEXT_PUBLIC_GTM_ID=

# Email Configuration (optional)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# PostgreSQL (für Docker)
POSTGRES_USER=gemilike
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=gemilike
