# syntax=docker/dockerfile:1.7

# Development Dockerfile
FROM node:20-alpine

# Install system dependencies for development (including image processing for color analysis)
RUN apk add --no-cache \
    libc6-compat \
    openssl \
    cairo-dev \
    jpeg-dev \
    pango-dev \
    giflib-dev \
    pixman-dev \
    libpng-dev \
    cairo \
    jpeg \
    pango \
    giflib \
    pixman \
    libpng \
    fontconfig \
    ttf-dejavu \
    ttf-liberation \
    python3 \
    make \
    g++

WORKDIR /app

# Copy package files
COPY package.json package-lock.json* ./

# Install all dependencies (including devDependencies) with cache mount
RUN --mount=type=cache,target=/root/.npm \
    npm ci --legacy-peer-deps

# Copy Prisma schema
COPY prisma ./prisma
RUN --mount=type=cache,target=/root/.cache/prisma \
    npx prisma generate

# Copy source code (will be overridden by volume in docker-compose)
# This is just to ensure the container has the basic structure
COPY . .

EXPOSE 3000

ENV PORT=3000
ENV HOSTNAME="0.0.0.0"
ENV NODE_ENV=development
ENV NEXT_TELEMETRY_DISABLED=1

# Use dev:lan to allow external connections
CMD ["npm", "run", "dev:lan"]

