# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here-change-in-production

# Database (PostgreSQL)
# Host-Port 5433 = docker-compose.yml (POSTGRES_PORT). `npm run dev` startet per predev-Skript
# den postgres-Service, falls Port 5433 noch nicht offen ist. Ohne Docker: SKIP_ENSURE_DEV_DB=1
DATABASE_URL="postgresql://gemilike:change-me-in-production@localhost:5433/gemilike?schema=public"

# Shop: Demo-Edelsteine bei fehlender DB (nur NODE_ENV=development). Abschalten: SHOP_DEV_FALLBACK=0
# SHOP_DEV_FALLBACK=0

# E-Mail Konfiguration (für Kontaktformular, Newsletter, Bestellbestätigungen)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gemilike.de
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@gemilike.de

# Analytics (optional)
NEXT_PUBLIC_GA_ID=your-google-analytics-id
